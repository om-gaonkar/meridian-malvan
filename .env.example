# ---- Site identity -----------------------------------------------------------
# Canonical production origin, e.g. https://www.yourhotel.in (no trailing slash).
# Must be a real https domain when ALLOW_INDEXING=true; the build fails otherwise.
NEXT_PUBLIC_SITE_URL=

# Set to "true" on the PRODUCTION deployment only. Anything else = noindex everywhere.
ALLOW_INDEXING=

# ---- Inquiry delivery (server-only; pick ONE route) --------------------------
# Option A: email via Resend (https://resend.com). All three are required together.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=

# Option B: forward inquiries to a hotel-management / CRM endpoint (takes priority over A).
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_SECRET=
